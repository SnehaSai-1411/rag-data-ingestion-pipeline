# No API keys are required — everything runs locally.
# Copy this file to .env and adjust the knobs if needed.

# Sentence-transformers model used by the embedder.
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Chunking defaults (characters). Overridden by --chunk-size / --overlap.
CHUNK_SIZE=800
OVERLAP=100

# Where the Chroma index is stored. Overridden by --persist-dir.
CHROMA_DIR=./chroma_db
